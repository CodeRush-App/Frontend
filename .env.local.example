# Next Configuration
NEXT_PUBLIC_API_URL=http://localhost:1234/api/v1

# Canonical URL of this frontend app (protocol + host + port)
# REQUIRED in every environment (local, staging, production)
# This is the base URL that Auth.js will use for constructing OAuth callbacks and validating redirects
# It will NOT fall back to client-supplied Host headers, so this must always be set correctly
AUTH_URL=http://localhost:3000

# Root domain shared by the frontend and the API which the session cookie is scoped to
# Leave unset if frontend and API are on the exact same host
# AUTH_COOKIE_DOMAIN=

# Cookie sameSite configuration (lax, strict, none)
COOKIE_SAMESITE=lax

# Authjs Configuration
AUTH_SECRET=your-auth-secret

# GitHub OAuth
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret

# Google OAuth
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
